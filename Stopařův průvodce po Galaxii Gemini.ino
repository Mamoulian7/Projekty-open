void drawHomeScreen();
void drawLoadingScreen(String title, String subtitle);
void drawCurrentArticlePage();
void drawErrorScreen(String title, String message);
void fetchGeminiArticle(String prompt, String fallbackTitle);
void recordAndSearch();
void connectWiFi();
void checkWiFiConnection();

// =========================================================================
//  SETUP & LOOP
// =========================================================================
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n--- STOPARUV PRUVODCE PO GALAXII (GEMINI AI EDITION) ---");

  // Zvukový výstup
  pinMode(BUZZER_PIN, OUTPUT);
  soundStartup(); 

  // Tlačítka joysticku
  pinMode(BTN_HOME, INPUT_PULLDOWN);
  pinMode(BTN_RANDOM, INPUT_PULLDOWN);
  pinMode(BTN_SEARCH, INPUT_PULLDOWN);
  pinMode(BTN_UP, INPUT_PULLDOWN);
  pinMode(BTN_DWN, INPUT_PULLDOWN);
  pinMode(BTN_LEFT, INPUT_PULLDOWN);
  pinMode(BTN_RIGHT, INPUT_PULLDOWN);

  // Napájení e-paper displeje
  pinMode(EPD_PWR, OUTPUT);
  digitalWrite(EPD_PWR, HIGH);
  delay(100); 

  // SPI a inicializace displeje
  SPI.begin(EPD_SCK, EPD_MISO, EPD_MOSI, EPD_CS); 
  display.init(115200, true, 50, false); 
  display.setRotation(1); 

  // Písma
  u8g2Fonts.begin(display);
  u8g2Fonts.setFontMode(1);                 
  u8g2Fonts.setFontDirection(0);            
  
  // Wi-Fi a mikrofon
  connectWiFi();
  initI2S();

  // Úvodní obrazovka
  drawHomeScreen();
}

void loop() {
  // DOMŮ (vlevo nebo BTN_HOME)
  if (digitalRead(BTN_HOME) == HIGH || digitalRead(BTN_LEFT) == HIGH) {
    soundClick();
    drawHomeScreen();
    delay(800); 
  }
  
  // NÁHODA (doprava nebo BTN_RANDOM) -> Dotaz na Gemini o reálná encyklopedická fakta
  if (digitalRead(BTN_RANDOM) == HIGH || digitalRead(BTN_RIGHT) == HIGH) {
    soundRandom();
    drawLoadingScreen("Hledám fakta...", "Gemini vybíra zajimavé téma");
    
    String prompt = "Vyber jedno zajimave, realne encyklopedicke tema nebo fascinujici vedecky, historicky, vesmirny ci prirodni fakt. "
                   "Vysvetli ho vecne, srozumitelne a poutave, presne jako v chytre encyklopedii nebo aplikaci Gemini v telefonu. "
                   "Odpovez v cestine. Zadny markdown, zadne formatovani, zadne hvezdicky, zadne uvozovky, zadne odrazky. "
                   "Na 1. radku POUZE a jedine strucny nazev hesla (max 4 slova). "
                   "Pak jeden prazdny radek. "
                   "Pak samotny text clanku s realnymi fakty a vysvetlenim (cca 120 az 180 slov).";
                   
    fetchGeminiArticle(prompt, "Náhodné heslo");
    delay(800);
  }
  
  // HLASOVÉ VYHLEDÁVÁNÍ (středové tlačítko BTN_SEARCH)
  if (digitalRead(BTN_SEARCH) == HIGH) {
    recordAndSearch();
    delay(800);
  }

  // LISTOVÁNÍ DOLŮ
  if (digitalRead(BTN_DWN) == HIGH && isReadingArticle) {
    int maxPages = (currentText.length() <= 0) ? 1 : ((currentText.length() - 1) / CHARS_PER_PAGE + 1);
    if (currentPage < maxPages - 1) {
      soundClick();
      currentPage++;
      drawCurrentArticlePage();
    } else {
      soundError(); 
    }
    delay(600);
  }

  // LISTOVÁNÍ NAHORU
  if (digitalRead(BTN_UP) == HIGH && isReadingArticle) {
    if (currentPage > 0) {
      soundClick();
      currentPage--;
      drawCurrentArticlePage();
    } else {
      soundError(); 
    }
    delay(600);
  }
  
  delay(50);
}

// --- SPRÁVA WI-FI ---
void connectWiFi() {
  Serial.print("Připojování k Wi-Fi: ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi pripojeno! IP: " + WiFi.localIP().toString());
  } else {
    Serial.println("\nChyba pripojeni k Wi-Fi!");
  }
}

void checkWiFiConnection() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }
}

// =========================================================================
//  GEMINI API VOLÁNÍ (Model gemini-3.6-flash s nízkou latencí)
// =========================================================================
//  GEMINI API VOLÁNÍ (Model gemini-3.6-flash přes přímé HTTPS spojení)
// =========================================================================
void fetchGeminiArticle(String prompt, String fallbackTitle) {
  checkWiFiConnection();

  WiFiClientSecure client;
  client.setInsecure(); // SSL bez ověřování CA certifikátu
  client.setTimeout(25000);

  Serial.println("Připojování ke Gemini API (generativelanguage.googleapis.com)...");
  if (!client.connect("generativelanguage.googleapis.com", 443)) {
    Serial.println("Nelze se připojit ke generativelanguage.googleapis.com");
    soundError();
    drawErrorScreen("Chyba sítě", "Nelze se spojit s Gemini servery.");
    return;
  }

  // Ošetření promptu proti rozbití JSON formátu
  String safePrompt = prompt;
  safePrompt.replace("\\", "\\\\");
  safePrompt.replace("\"", "\\\"");
  safePrompt.replace("\r", " ");
  safePrompt.replace("\n", " ");

  // Sestavení JSON pro Gemini 3.6 Flash
  // DŮLEŽITÉ: maxOutputTokens musí být 2048, protože model gemini-3.6-flash
  // započítává do limitu i myšlenkové tokeny (thinking).
  String requestBody = "{"
    "\"contents\":[{\"parts\":[{\"text\":\"" + safePrompt + "\"}]}],"
    "\"generationConfig\":{"
      "\"maxOutputTokens\":2048,"
      "\"temperature\":0.7,"
      "\"thinkingConfig\":{\"thinkingLevel\":\"low\"}"
    "}"
  "}";

  String path = "/v1beta/models/" + String(GEMINI_MODEL) + ":generateContent?key=" + String(GEMINI_API_KEY);

  Serial.println("Odesilam dotaz na Gemini (" + String(GEMINI_MODEL) + ")...");
  client.println("POST " + path + " HTTP/1.1");
  client.println("Host: generativelanguage.googleapis.com");
  client.println("Content-Type: application/json");
  client.print("Content-Length: ");
  client.println(requestBody.length());
  client.println("Connection: close");
  client.println();
  client.print(requestBody);

  // Čtení stavového kódu HTTP (např. HTTP/1.1 200 OK)
  int statusCode = 0;
  long startTime = millis();
  while (client.connected() || client.available()) {
    if (client.available()) {
      String statusLine = client.readStringUntil('\n');
      int firstSpace = statusLine.indexOf(' ');
      if (firstSpace > 0) {
        statusCode = statusLine.substring(firstSpace + 1, firstSpace + 4).toInt();
      }
      break;
    }
    if (millis() - startTime > 25000) {
      Serial.println("Timeout čekání na odpověď Gemini.");
      break;
    }
  }

  // Přeskočení HTTP hlaviček až do prázdného řádku
  while (client.connected() || client.available()) {
    String headerLine = client.readStringUntil('\n');
    if (headerLine == "\r" || headerLine.length() == 0) {
      break;
    }
  }

  // Čtení samotného těla (JSON)
  String responseBody = "";
  long readTimeout = millis();
  while (client.connected() || client.available()) {
    if (client.available()) {
      responseBody += client.readString();
      readTimeout = millis();
    }
    if (millis() - readTimeout > 15000) {
      break;
    }
  }
  client.stop();

  Serial.printf("Gemini HTTP status: %d\n", statusCode);

  if (statusCode != 200) {
    Serial.println("Chyba Gemini API odpověď:");
    Serial.println(responseBody);
    soundError();
    drawErrorScreen("Chyba Gemini", "HTTP kód: " + String(statusCode));
    return;
  }

  // Oříznutí na čistý JSON objekt pro případ chunked encoding
  int jsonStart = responseBody.indexOf('{');
  int jsonEnd = responseBody.lastIndexOf('}');
  if (jsonStart >= 0 && jsonEnd > jsonStart) {
    responseBody = responseBody.substring(jsonStart, jsonEnd + 1);
  }

  JsonDocument resDoc;
  DeserializationError err = deserializeJson(resDoc, responseBody);

  if (!err && resDoc.containsKey("candidates")) {
    JsonArray parts = resDoc["candidates"][0]["content"]["parts"].as<JsonArray>();
    String fullResponse = "";
    for (JsonObject p : parts) {
      // Přeskočíme případné myšlenkové tokeny (thought)
      if (p.containsKey("thought") && p["thought"].as<bool>()) {
        continue;
      }
      if (p.containsKey("text")) {
        fullResponse += p["text"].as<String>();
      }
    }
    
    fullResponse = cleanMarkdown(fullResponse);
    fullResponse.trim();

    // Oddělení titulku (1. řádek) a textu článku
    int firstNewLine = fullResponse.indexOf('\n');
    if (firstNewLine > 0) {
      currentTitle = fullResponse.substring(0, firstNewLine);
      currentTitle.trim();
      currentText = fullResponse.substring(firstNewLine + 1);
      currentText.trim();
    } else {
      currentTitle = fallbackTitle;
      currentText = fullResponse;
    }

    currentPage = 0;
    isReadingArticle = true;
    drawCurrentArticlePage();
  } else {
    soundError();
    Serial.printf("Chyba deserializace JSON: %s\n", err.c_str());
    drawErrorScreen("Chyba dat", "Gemini vrátilo nečitelný format JSON.");
  }
}

