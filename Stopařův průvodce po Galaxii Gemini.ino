//  HLASOVÉ NAHRÁVÁNÍ A PŘEPIS (Google Speech-to-Text nebo Whisper)
// =========================================================================
#if USE_GOOGLE_SPEECH
// --- GOOGLE CLOUD SPEECH-TO-TEXT ---
String transcribeAudioGoogle(int16_t* audioBuffer, int sampleCount) {
  checkWiFiConnection();

  // Kódování audia do Base64
  size_t inputLen = sampleCount * 2;
  size_t b64Len = 0;
  mbedtls_base64_encode(NULL, 0, &b64Len, (const unsigned char*)audioBuffer, inputLen);
  
  char* b64Buffer = (char*)ps_malloc(b64Len + 1);
  if (!b64Buffer) b64Buffer = (char*)malloc(b64Len + 1);
  if (!b64Buffer) {
    Serial.println("Nedostatek paměti pro Base64 audio!");
    return "";
  }

  size_t actualLen = 0;
  mbedtls_base64_encode((unsigned char*)b64Buffer, b64Len + 1, &actualLen, (const unsigned char*)audioBuffer, inputLen);
  b64Buffer[actualLen] = '\0';

  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(25000);

  Serial.println("Připojovaní ke Google Speech-to-Text API...");
  if (!client.connect("speech.googleapis.com", 443)) {
    Serial.println("Nelze se připojit ke speech.googleapis.com");
    free(b64Buffer);
    return "";
  }

  String head = "{\"config\":{\"encoding\":\"LINEAR16\",\"sampleRateHertz\":16000,\"languageCode\":\"cs-CZ\"},\"audio\":{\"content\":\"";
  String tail = "\"}}";
  int totalContentLength = head.length() + actualLen + tail.length();

  client.println("POST /v1/speech:recognize?key=" + String(GOOGLE_SPEECH_KEY) + " HTTP/1.1");
  client.println("Host: speech.googleapis.com");
  client.println("Content-Type: application/json");
  client.print("Content-Length: ");
  client.println(totalContentLength);
  client.println("Connection: close");
  client.println();

  // Streamované odeslání bez nutnosti alokovat velký řetězec v paměti
  client.print(head);
  client.write((const uint8_t*)b64Buffer, actualLen);
  client.print(tail);

  free(b64Buffer); // Uvolnění Base64 z paměti

  Serial.println("Audio odesláno, čekám na přepis...");

  String response = "";
  bool headersPassed = false;
  long timeout = millis();

  while (client.connected() || client.available()) {
    if (client.available()) {
      String line = client.readStringUntil('\n');
      if (line == "\r") {
        headersPassed = true;
      } else if (headersPassed) {
        response += line;
      }
      timeout = millis();
    }
    if (millis() - timeout > 15000) {
      Serial.println("Timeout čekání na Google Speech");
      break;
    }
  }
  client.stop();

  Serial.println("Google Speech odpověď:");
  Serial.println(response);

  // Oříznutí HTTP chunked přenosových kódů (např. 11c ... 0) na čistý JSON objekt
  int jsonStart = response.indexOf('{');
  int jsonEnd = response.lastIndexOf('}');
  if (jsonStart >= 0 && jsonEnd > jsonStart) {
    response = response.substring(jsonStart, jsonEnd + 1);
  }

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, response);
  if (!err && doc.containsKey("results")) {
    JsonArray results = doc["results"].as<JsonArray>();
    if (results.size() > 0) {
      String transcript = results[0]["alternatives"][0]["transcript"].as<String>();
      Serial.println("Úspěšně rozpoznaný text: " + transcript);
      return cleanPunctuation(transcript);
    }
  } else if (err) {
    Serial.printf("Chyba deserializace JSON: %s\n", err.c_str());
  }

  return "";
}

#else
// --- OPENAI WHISPER ---
String transcribeAudioWhisper(int16_t* audioBuffer, int sampleCount) {
  checkWiFiConnection();

  WiFiClientSecure client;
  client.setInsecure(); 
  
  const char* host = "api.openai.com";
  if (!client.connect(host, 443)) {
    Serial.println("Chyba připojování k OpenAI");
    return "";
  }
  
  String boundary = "----WebKitFormBoundary7MA4YWxkTrZu0gW";
  
  WAVHeader wavHeader;
  wavHeader.dataSize = sampleCount * 2;
  wavHeader.chunkSize = 36 + wavHeader.dataSize;
  
  String head = "--" + boundary + "\r\n";
  head += "Content-Disposition: form-data; name=\"file\"; filename=\"audio.wav\"\r\n";
  head += "Content-Type: audio/wav\r\n\r\n";
  
  String tail = "\r\n--" + boundary + "\r\n";
  tail += "Content-Disposition: form-data; name=\"model\"\r\n\r\n";
  tail += "whisper-1\r\n";
  tail += "--" + boundary + "\r\n";
  tail += "Content-Disposition: form-data; name=\"language\"\r\n\r\n";
  tail += "cs\r\n";
  tail += "--" + boundary + "--\r\n";
  
  uint32_t contentLength = head.length() + sizeof(WAVHeader) + (sampleCount * 2) + tail.length();
  
  client.println("POST /v1/audio/transcriptions HTTP/1.1");
  client.println("Host: api.openai.com");
  client.print("Authorization: Bearer ");
  client.println(OPENAI_API_KEY);
  client.print("Content-Type: multipart/form-data; boundary=");
  client.println(boundary);
  client.print("Content-Length: ");
  client.println(contentLength);
  client.println();
  
  client.print(head);
  client.write((uint8_t*)&wavHeader, sizeof(WAVHeader));
  client.write((uint8_t*)audioBuffer, sampleCount * 2);
  client.print(tail);
  
  String response = "";
  bool headersPassed = false;
  long timeout = millis();
  while (client.connected() || client.available()) {
    if (client.available()) {
      String line = client.readStringUntil('\n');
      if (line == "\r") {
        headersPassed = true;
      } else if (headersPassed) {
        response += line;
      }
      timeout = millis();
    }
    if (millis() - timeout > 10000) break;
  }
  client.stop();

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, response);
  if (!err && doc.containsKey("text")) {
    String query = doc["text"].as<String>();
    return cleanPunctuation(query);
  }
  return "";
}
