// --- HLAVNÍ METODA NAHRÁVÁNÍ A VYHLEDÁNÍ ---
void recordAndSearch() {
  drawLoadingScreen("Mluvte teď...", "Říkejte dotaz do mikrofonu...");
  soundRecordStart();

  int maxSamples = 16000 * 5; // Až 5 sekund záznamu
  int16_t* audioBuffer = (int16_t*)ps_malloc(maxSamples * 2);
  if (!audioBuffer) audioBuffer = (int16_t*)malloc(maxSamples * 2);
  
  if (!audioBuffer) {
    soundError();
    drawErrorScreen("Chyba paměti", "Nedostatek RAM pro nahrávání.");
    return;
  }

  int sampleCount = 0;
  size_t bytesRead;
  int32_t rawSample = 0;
  
  // Vyčistíme starý šum v bufferu mikrofonu
  i2s_read(I2S_NUM_0, &rawSample, 4, &bytesRead, 100);

  // CHYTRÉ NAHRÁVÁNÍ:
  // Podporuje jak pouhé kliknutí (stisk a puštění), tak držení tlačítka.
  // Nahrává po dobu řeči (až 4.5 sekundy).
  // Pokud uživatel tlačítko drží a pustí ho po více než 1.8 s, nahrávání se ukončí.
  // Pokud uživatel jen kliknul, nahrává celých 4.5 s nebo dokud nestiskne tlačítko znovu po 1.5 s.
  delay(120); // Debounce
  bool buttonHeld = (digitalRead(BTN_SEARCH) == HIGH);
  unsigned long startRecordTime = millis();
  const unsigned long MAX_RECORD_MS = 4500; // Maximálně 4.5 sekundy
  const unsigned long MIN_RECORD_MS = 1800; // Minimální délka záznamu (proti useknutí)

  while (sampleCount < maxSamples) {
    unsigned long elapsed = millis() - startRecordTime;
    if (elapsed >= MAX_RECORD_MS) break;

    i2s_read(I2S_NUM_0, &rawSample, 4, &bytesRead, portMAX_DELAY);
    rawSample >>= 14; 
    audioBuffer[sampleCount++] = (int16_t)rawSample;

    // Pokud uživatel tlačítko držel, ukončíme po uvolnění (ale až po dosažení minimálního času)
    if (buttonHeld && elapsed >= MIN_RECORD_MS && digitalRead(BTN_SEARCH) == LOW) {
      break;
    }
    // Pokud uživatel jen kliknul (rychle pustil), může nahrávání ukončit dalším stiskem po 1.5 s
    if (!buttonHeld && elapsed >= 1500 && digitalRead(BTN_SEARCH) == HIGH) {
      break;
    }
  }

  soundRecordStop();
  drawLoadingScreen("Rozpoznávám hlas...", "Google Speech převádi audio");

  String transcribedQuery = "";
#if USE_GOOGLE_SPEECH
  transcribedQuery = transcribeAudioGoogle(audioBuffer, sampleCount);
#else
  transcribedQuery = transcribeAudioWhisper(audioBuffer, sampleCount);
#endif

  free(audioBuffer); // Uvolnění nahrávky

  if (transcribedQuery.length() == 0) {
    soundError();
    Serial.println("Nepodařilo se rozpoznat hlas.");
    drawErrorScreen("Nerozuměl jsem", "Zkuste mluvit zblízka do mikrofonu.");
    return;
  }

  Serial.println("Rozpoznaný dotaz: " + transcribedQuery);
  drawLoadingScreen("Dotaz: " + transcribedQuery, "Gemini hledá presná fakta");

  // Dotaz na Gemini s položenou otázkou - reálná fakta jako v telefonu
  String geminiPrompt = "Odpovez na nasledujici dotaz vecne, presne a s realnymi fakty jako inteligentni encyklopedie nebo Gemini v telefonu. "
                        "Odpovez v cestine. Zadny markdown, zadne hvezdicky, zadne uvozovky, zadne odrazky. "
                        "Na 1. radku POUZE vystizny a strucny nazev hesla (max 4 slova). "
                        "Pak jeden prazdny radek. "
                        "Pak samotny text clanku s podrobnymi fakty a vysvetlenim (cca 120 az 200 slov). "
                        "DOTAZ: " + transcribedQuery;

  fetchGeminiArticle(geminiPrompt, transcribedQuery);
}

// =========================================================================
//  GRAFICKÉ FUNKCE PRO E-PAPER DISPLEJ
// =========================================================================
int printWrappedText(String text, int startX, int startY, int maxWidth) {
  int x = startX;
  int y = startY;
  int lineHeight = u8g2Fonts.getFontAscent() - u8g2Fonts.getFontDescent() + 4; 
  
  String word = "";
  for (int i = 0; i <= text.length(); i++) {
    char c = (i < text.length()) ? text.charAt(i) : ' ';
    if (c == ' ' || c == '\n' || i == text.length()) {
      if (word.length() > 0) {
        int wordWidth = u8g2Fonts.getUTF8Width(word.c_str());
        if (x + wordWidth > startX + maxWidth) {
          x = startX;
          y += lineHeight;
        }
        u8g2Fonts.setCursor(x, y);
        u8g2Fonts.print(word);
        x += wordWidth + u8g2Fonts.getUTF8Width(" ");
        word = "";
      }
      if (c == '\n') {
        x = startX;
        y += lineHeight;
      }
    } else {
      word += c;
    }
  }
  return y;
}

void drawCurrentArticlePage() {
  display.setFullWindow();
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    
    // Černá horní lišta
    display.fillRect(0, 0, 300, 25, GxEPD_BLACK);
    u8g2Fonts.setForegroundColor(GxEPD_WHITE);
    u8g2Fonts.setBackgroundColor(GxEPD_BLACK);
    u8g2Fonts.setFont(u8g2_font_helvB12_te); 
    
    u8g2Fonts.setCursor(10, 18);
    u8g2Fonts.print("Mk.III (Gemini)");
    
    int maxPages = (currentText.length() <= 0) ? 1 : ((currentText.length() - 1) / CHARS_PER_PAGE + 1);
    u8g2Fonts.setCursor(215, 18);
    u8g2Fonts.print("STR " + String(currentPage + 1) + "/" + String(maxPages));

    // Červený titulek (dynamicky zalomený)
    u8g2Fonts.setForegroundColor(GxEPD_RED);
    u8g2Fonts.setBackgroundColor(GxEPD_WHITE);
    u8g2Fonts.setFont(u8g2_font_helvB14_te); 
    
    int titleEndY = printWrappedText(currentTitle, 10, 50, 280);

    // Červená oddělovací linka dynamicky pod titulkem
    int lineY = titleEndY + 8;
    display.fillRect(10, lineY, 280, 2, GxEPD_RED);

    // Text článku přehledně pod linkou
    u8g2Fonts.setForegroundColor(GxEPD_BLACK);
    u8g2Fonts.setFont(u8g2_font_helvB10_te); 
    
    int startIndex = currentPage * CHARS_PER_PAGE;
    int endIndex = startIndex + CHARS_PER_PAGE;
    if (endIndex > currentText.length()) endIndex = currentText.length();
    
    String pageText = currentText.substring(startIndex, endIndex);
    if (endIndex < currentText.length()) pageText += "..."; 
    
    printWrappedText(pageText, 10, lineY + 20, 280);
    
  } while (display.nextPage());
}

