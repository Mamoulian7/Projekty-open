// --- STRUKTURA PRO WAV HLAVIČKU (pro OpenAI Whisper) ---
#pragma pack(push, 1)
struct WAVHeader {
  char riff[4] = {'R', 'I', 'F', 'F'};
  uint32_t chunkSize;
  char wave[4] = {'W', 'A', 'V', 'E'};
  char fmt[4] = {'f', 'm', 't', ' '};
  uint32_t fmtSize = 16;
  uint16_t audioFormat = 1;
  uint16_t numChannels = 1;
  uint32_t sampleRate = 16000;
  uint32_t byteRate = 16000 * 2;
  uint16_t blockAlign = 2;
  uint16_t bitsPerSample = 16;
  char data[4] = {'d', 'a', 't', 'a'};
  uint32_t dataSize;
};
#pragma pack(pop)

// --- ZVUKOVÉ EFEKTY ---
void playBeep(int freq, int duration) {
  tone(BUZZER_PIN, freq, duration);
  delay(duration + 20);
}

void soundStartup() {
  playBeep(523, 100); // C5
  playBeep(659, 100); // E5
  playBeep(784, 100); // G5
  playBeep(1046, 200); // C6
}

void soundClick() {
  tone(BUZZER_PIN, 1200, 30);
}

void soundRandom() {
  // Zvuk nabíjení nepravděpodobnostního pohonu
  for (int i = 400; i < 1500; i += 100) {
    tone(BUZZER_PIN, i, 20);
    delay(20);
  }
  noTone(BUZZER_PIN);
}

void soundError() {
  playBeep(300, 250);
  playBeep(200, 400);
}

void soundRecordStart() {
  playBeep(1000, 100);
  playBeep(1500, 100);
}

void soundRecordStop() {
  playBeep(1500, 100);
  playBeep(1000, 100);
}

// --- POMOCNÉ FUNKCE PRO TEXT ---
String cleanMarkdown(String text) {
  text.replace("**", "");
  text.replace("*", "");
  text.replace("##", "");
  text.replace("#", "");
  text.replace("`", "");
  text.replace("\"", "");
  text.replace("\r", "");
  return text;
}

String cleanPunctuation(String text) {
  text.trim();
  while (text.length() > 0 && (text.endsWith(".") || text.endsWith(",") || text.endsWith("!") || text.endsWith("?"))) {
    text = text.substring(0, text.length() - 1);
  }
  return text;
}

// --- INICIALIZACE I2S MIKROFONU ---
void initI2S() {
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = 16000,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_32BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 8,
    .dma_buf_len = 1024,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0
  };
  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_BCLK,
    .ws_io_num = I2S_LRCLK,
    .data_out_num = I2S_PIN_NO_CHANGE,
    .data_in_num = I2S_DOUT
  };
  i2s_driver_install(I2S_NUM_0, &i2s_config, 0, NULL);
  i2s_set_pin(I2S_NUM_0, &pin_config);
}

